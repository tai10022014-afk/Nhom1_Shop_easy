    <style name="Theme.KiemTra_LapTrinhUngDungDiDong_2474802010345" parent="Base.Theme.KiemTra_LapTrinhUngDungDiDong_2474802010345" />

    <style name="Widget.ShopEasy.Button" parent="Widget.Material3.Button">

<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.KiemTra_LapTrinhUngDungDiDong_2474802010345" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:colorBackground">@color/app_background</item>
